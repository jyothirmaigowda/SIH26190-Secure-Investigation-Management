{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "middleware/**/*.ts",
    "routes/**/*.ts",
    "utils/**/*.ts",
    "auth/**/*.ts",
    "cases/**/*.ts",
    "documents/**/*.ts",
    "evidence/**/*.ts",
    "permissions/**/*.ts",
    "audit/**/*.ts",
    "ai/**/*.ts",
    "services/**/*.ts",
    "controllers/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
